# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/benchmarks/results/
/benchmarks/fixtures/*.wav
/benchmarks/fixtures/user/*
!/benchmarks/fixtures/user/.gitkeep
/test-results/
debug-*.log

# local scrapes / reference dumps (do not publish)
/reference.html
/reference.css
/reference2.css
/reference*.html
/reference*.css

# local agent / editor tooling
.agents/
.codex/
.cursor/
.vscode/
scripts/mcp-diag.ps1

# python
__pycache__/
*.py[cod]
backend/.venv*/
backend/**/__pycache__/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.webm

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
